# PostgreSQL connection: an installed PostgreSQL (port 5432, user postgres / postgres). `npm run db:migrate` creates the lms database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lms?schema=public"
PORT=3000
# Comma-separated list of allowed browser origins (CORS, with credentials).
CORS_ORIGIN=http://localhost:5174
# Required in production (min. 32 chars). In development a built-in default is used with a warning.
JWT_SECRET=
# Time zone used for "today", due dates, overdue and "this month".
APP_TIMEZONE=Asia/Manila
# Optional: port for `npm run db:local` (embedded PostgreSQL, only if no PostgreSQL is installed). Keep DATABASE_URL on the same port.
# DB_LOCAL_PORT=5433
# Optional: Express "trust proxy" when behind a reverse proxy (so rate limits see real client IPs), e.g. 1.
# Only set it if that proxy sets X-Forwarded-For (nginx, or the Vite proxy with `xfwd: true`); otherwise clients
# could spoof their IP. Without it, everyone behind the proxy shares one IP for the public-form rate limits.
# TRUST_PROXY=1

# --- Accounts for borrowers and email (all optional) ---
# Address of the web app, used for the sign-in link in emails (default http://localhost:5174).
# APP_PUBLIC_URL=https://library.example.org
# First password of the account created for a borrower when their first request is accepted (an ordinary account
# with the default role, see Users → Accounts). It is written in the acceptance email and must be changed at the first
# sign-in. At least 8 characters; default password123.
# BORROWER_DEFAULT_PASSWORD=password123
# Outgoing mail server for the accept/reject emails. Without SMTP_HOST nothing is sent: in development the email is
# printed in the backend terminal instead. The email is attempted when staff accept/reject; a failure is shown on
# the borrow record (with a "Resend email" button) and never undoes the decision.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE: true for port 465 (TLS from the start); false (default) uses STARTTLS, e.g. on 587.
# SMTP_SECURE=false
# SMTP_USER=library@example.org
# SMTP_PASS=app-password
# Sender shown in the email. Default: the company name. Without an address in it, mail is sent from SMTP_USER
# (when that is an email address), else from no-reply@localhost.
# MAIL_FROM="St. Luke Library <library@example.org>"
# Optional: the password `npm run db:seed` gives admin@localhost (at least 8 characters; default password123).
# SEED_ADMIN_PASSWORD=
