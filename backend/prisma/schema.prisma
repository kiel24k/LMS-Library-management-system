// Prisma schema — Library Lending System (see docs/SPEC.md)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LoanStatus {
  PENDING
  BORROWED
  PARTIALLY_RETURNED
  RETURNED
  REJECTED
  CANCELLED
}

enum LoanSource {
  STAFF
  PUBLIC_FORM
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique // stored lower-cased
  name               String
  passwordHash       String
  roleId             String
  active             Boolean  @default(true)
  /// Copied into every JWT; bumping it (password change/reset, deactivation, logout) invalidates older tokens.
  tokenVersion       Int      @default(0)
  /// True while the account still has a password it was given (BORROWER_DEFAULT_PASSWORD when a borrow request was
  /// accepted); the app sends the user to change it before anything else. Cleared by PATCH /auth/password.
  mustChangePassword Boolean  @default(false)
  /// The borrower this account belongs to (set when one of their requests is accepted): the "My Books" page shows
  /// that borrower's records. null = a staff-only account.
  borrowerId         String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  loansCreated    Loan[]         @relation("LoanCreatedBy")
  loansApproved   Loan[]         @relation("LoanApprovedBy")
  loansClosed     Loan[]         @relation("LoanClosedBy")
  returnsReceived ReturnRecord[]

  role     Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  borrower Borrower? @relation(fields: [borrowerId], references: [id], onDelete: SetNull)

  @@index([roleId])
}

/// A named set of permissions (role-based access control; catalog in src/lib/permissions.ts). Every user has
/// exactly one role; nobody bypasses the permission checks, not even the "Administrator" role.
model Role {
  id          String   @id @default(cuid())
  // Unique regardless of case: the migration 20261104120000_rbac adds UNIQUE (lower("name")), which Prisma
  // cannot express in the schema.
  name        String   @unique
  description String?
  /// Permission keys, normalized (requires added, catalog order).
  permissions String[]
  /// The role new accounts get when POST /users sends no roleId. At most one role is the default: the migration
  /// 20261104130000_default_role adds a partial UNIQUE ("isDefault") WHERE "isDefault", which Prisma cannot
  /// express in the schema.
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model Library {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique // used in public form URL: /borrow/:slug
  description       String?
  location          String?
  publicFormEnabled Boolean  @default(false)
  defaultLoanDays   Int      @default(7) // 1..365
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  categories Category[]
  books      Book[]
  loans      Loan[]
}

/// A "grouping" (section) inside a library.
model Category {
  id          String   @id @default(cuid())
  libraryId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  books   Book[]

  // Names are unique per library regardless of case: the migration
  // 20261103150000_category_name_case_insensitive adds UNIQUE ("libraryId", lower("name")),
  // which Prisma cannot express in the schema.
  @@unique([libraryId, name])
}

model Book {
  id              String   @id @default(cuid())
  libraryId       String
  categoryId      String?
  title           String
  author          String?
  isbn            String?
  publisher       String?
  publicationYear Int?
  callNumber      String?
  totalCopies     Int      @default(1) // >= 0 (CHECK constraint in migration)
  availableCopies Int      @default(1) // 0..totalCopies (CHECK constraint in migration)
  notes           String?
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  library   Library    @relation(fields: [libraryId], references: [id], onDelete: Restrict)
  category  Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  loanItems LoanItem[]
  cover     BookCover?

  @@index([libraryId, categoryId])
  @@index([title])
}

/// The book's picture, kept in the database (backed up with it; no upload folder). Staff-only.
model BookCover {
  bookId    String   @id
  mimeType  String // image/jpeg | image/png | image/webp (checked against the file's first bytes)
  data      Bytes // at most 1 MB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Borrower {
  id                 String   @id @default(cuid())
  name               String
  idNumber           String?  @unique
  contact            String?
  affiliation        String?
  /// Stored trimmed and lower-cased. Required on public requests: the accept/reject email goes here, and it is
  /// the sign-in email of the account created for them (a `User` linked through `User.borrowerId`).
  email              String?  @unique
  /// Deprecated: moved to User by migration 20261104150000_one_account_system; kept until the owner approves removing it.
  passwordHash       String?
  /// Deprecated: moved to User by migration 20261104150000_one_account_system; kept until the owner approves removing it.
  mustChangePassword Boolean  @default(false)
  /// Deprecated: moved to User by migration 20261104150000_one_account_system; kept until the owner approves removing it.
  tokenVersion       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  loans Loan[]
  /// The sign-in account linked to this borrower (Users → Accounts), if any.
  user  User?

  @@index([name])
}

model Loan {
  id            String     @id @default(cuid())
  number        Int        @unique @default(autoincrement()) // shown as LN-000123
  libraryId     String
  borrowerId    String
  source        LoanSource
  status        LoanStatus
  requestedAt   DateTime   @default(now())
  borrowedAt    DateTime?
  dueDate       DateTime?  @db.Date
  closedAt      DateTime?
  notes         String?
  staffNotes    String?
  submittedName String?
  createdById   String?
  approvedById  String?
  closedById    String?
  /// When the accept/reject email was last sent successfully (null = never).
  notifiedAt    DateTime?
  /// Why the last accept/reject email failed (null = no failure since the last success / never tried).
  notifyError   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  library    Library        @relation(fields: [libraryId], references: [id], onDelete: Restrict)
  borrower   Borrower       @relation(fields: [borrowerId], references: [id], onDelete: Restrict)
  createdBy  User?          @relation("LoanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?          @relation("LoanApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  closedBy   User?          @relation("LoanClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  items      LoanItem[]
  returns    ReturnRecord[]

  @@index([libraryId, status])
  @@index([borrowerId])
  @@index([status, dueDate])
  @@index([requestedAt])
}

model LoanItem {
  id              String   @id @default(cuid())
  loanId          String
  bookId          String
  quantity        Int // >= 1
  returnedGood    Int      @default(0)
  returnedDamaged Int      @default(0)
  lost            Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  loan        Loan               @relation(fields: [loanId], references: [id], onDelete: Cascade)
  book        Book               @relation(fields: [bookId], references: [id], onDelete: Restrict)
  returnItems ReturnRecordItem[]

  @@unique([loanId, bookId])
  @@index([bookId])
}

/// One per return check (partial returns allowed).
model ReturnRecord {
  id             String   @id @default(cuid())
  loanId         String
  receivedById   String
  receivedAt     DateTime @default(now())
  returnedByName String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  loan       Loan               @relation(fields: [loanId], references: [id], onDelete: Restrict)
  receivedBy User               @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  items      ReturnRecordItem[]

  @@index([loanId])
  @@index([receivedAt])
}

model ReturnRecordItem {
  id             String   @id @default(cuid())
  returnRecordId String
  loanItemId     String
  good           Int      @default(0)
  damaged        Int      @default(0)
  lost           Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  returnRecord ReturnRecord @relation(fields: [returnRecordId], references: [id], onDelete: Cascade)
  loanItem     LoanItem     @relation(fields: [loanItemId], references: [id], onDelete: Restrict)

  @@index([returnRecordId])
  @@index([loanItemId])
}

/// The organisation's name, logo and contact details, shown on every page and in emails. Exactly one row (id 1):
/// the migration 20261104140000_company_profile_borrower_accounts adds CHECK ("id" = 1) and inserts it, which
/// Prisma cannot express in the schema. Code still copes with the row missing (defaults; upsert on save).
model CompanyProfile {
  id           Int      @id @default(1)
  name         String   @default("Library System") // 1..120
  tagline      String? // <= 200
  address      String? // <= 300
  contactEmail String? // <= 254
  contactPhone String? // <= 60
  logoMimeType String? // image/png | image/jpeg | image/webp (checked against the file's first bytes)
  logoData     Bytes? // at most 512 KB
  updatedAt    DateTime @updatedAt
}
